# Template variabili d'ambiente per la PoC MIA-su-RAG.
# Copia in `.env` e riempi con le tue chiavi. `.env` NON va committato (vedi .gitignore).

# ─────────────────────────────────────────────────────────────
# Azure OpenAI — GPT-4o-mini (modello target black-box commerciale)
# ─────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<tuo-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# AWS Bedrock — Claude (Opus/Sonnet) come target black-box
# Le credenziali AWS possono stare qui o nel profilo ~/.aws/credentials.
# ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-west-1
# Model ID Bedrock (esempio; adatta alla region e ai modelli abilitati sul tuo account):
BEDROCK_CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ─────────────────────────────────────────────────────────────
# Ollama — modello target locale (nessuna chiave; solo endpoint)
# ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TARGET_MODEL=llama3.1:8b

# ─────────────────────────────────────────────────────────────
# Provider selection (v0.2). Default = v0.1-thesis behavior.
# ─────────────────────────────────────────────────────────────
# LLM_PROVIDER: ollama | azure_openai | bedrock
LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER: sentence_tf | openai_embed
EMBEDDING_PROVIDER=sentence_tf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Per Azure embeddings: nome del deployment embedding
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ─────────────────────────────────────────────────────────────
# Perplexity scorer (per feature S2MIA).
# PERPLEXITY_PROVIDER: gpt2 (default, EN proxy) | hf_causal (custom model)
# Note: GPT-2 trained EN but used as proxy on IT corpus — common practice in MIA
# literature (Li 2025). Alternative IT models require gated access (Minerva) or
# lack causal LM (BERT-IT). Default gpt2 = fast, correlato con ground-truth PPL.
# ─────────────────────────────────────────────────────────────
PERPLEXITY_PROVIDER=gpt2
# PERPLEXITY_HF_MODEL=sapienzanlp/Minerva-350M-base-v1.0  # IT, gated — requires HF approval

# ─────────────────────────────────────────────────────────────
# RAG params
# ─────────────────────────────────────────────────────────────
TOP_K=4
SEED=42
